{
  "name": "trax3ion-pm-concept-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "lint": "eslint .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "validate:component-layout": "node scripts/validate-component-layout.mjs",
    "test:component": "npm run validate:component-layout && vitest run --config vitest.component.config.ts",
    "test:e2e": "cypress run",
    "test": "npm run test:unit && npm run test:component",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "wrangler:dev": "npm run build && npx wrangler dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "lucide-react": "^1.44.0",
    "openai": "^7.15.0",
    "preline": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.6",
    "cypress": "^16.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
